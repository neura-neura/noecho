+
+bool processAncestorAtRuntime (unsigned long root, unsigned long child)
+{
+    if (root == child) return true;
+    const auto snapshot = CreateToolhelp32Snapshot (TH32CS_SNAPPROCESS, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) return false;
+    std::unordered_map<DWORD,DWORD> parents;
+    PROCESSENTRY32W entry {}; entry.dwSize = sizeof (entry);
+    if (Process32FirstW (snapshot, &entry))
+        do { parents[entry.th32ProcessID] = entry.th32ParentProcessID; } while (Process32NextW (snapshot, &entry));
+    CloseHandle (snapshot);
+    for (int depth = 0; depth < 128 && parents.contains (child); ++depth)
+    {
+        const auto parent = parents[child];
+        if (parent == root) return true;
+        if (parent == 0 || parent == child) return false;
+        child = parent;
+    }
+    return false;
+}
