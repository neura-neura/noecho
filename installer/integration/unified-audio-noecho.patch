+    for (std::size_t index = 0; index < maxProcessCaptures; ++index)
+        noEchoPrivate[index].store (enabled && noEchoMatches (apps, processCaptureKeys[index]));
+    noEchoEnabled.store (enabled);
+    heartbeatNoEcho();
+    noEchoError.clear();
+    if (getMixerMode() != MixerMode::voice)
+    {
+        systemCapture.stop();
+        if (useProcessCapture()) noEchoError = reconcileProcessCaptures();
+        else
+        {
+            stopProcessCaptures();
+            noEchoError = systemCapture.start (processFilterDeviceName, processFilterDeviceId, graphSampleRate.load());
+        }
+    }
+    return noEchoError;
