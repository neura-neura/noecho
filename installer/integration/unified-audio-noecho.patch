+class NoEchoTests final : public juce::UnitTest
+{
+public:
+    NoEchoTests() : juce::UnitTest ("NoEcho final mix", "Audio") {}
+    void runTest() override
+    {
+        beginTest ("Same-frame subtraction preserves voice and allowed audio under gain changes");
+        for (const auto gain : { 0.0f, 0.15f, 0.75f, 1.0f, 2.0f })
+            for (int i = 0; i < 1000; ++i)
+            {
+                const auto voice = std::sin (i * 0.13f) * 0.2f;
+                const auto allowed = std::sin (i * 0.07f) * 0.1f;
+                const auto selected = std::sin (i * 0.29f) * 0.3f;
+                const auto mixed = voice + (allowed + selected) * gain;
+                expectWithinAbsoluteError (removeNoEchoContribution (mixed, selected, gain), voice + allowed * gain, 0.000001f);
+            }
+        beginTest ("Executable identity matches across restarts and casing");
+        expect (noEchoMatches ({ "ayugram.exe" }, "C:\\Apps\\AyuGram.exe"));
+        expect (! noEchoMatches ({ "ayugram.exe" }, "C:\\Apps\\other.exe"));
