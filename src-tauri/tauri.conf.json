{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoEcho",
  "version": "0.2.6",
  "identifier": "com.noecho.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoEcho",
        "width": 800,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true,
        "minWidth": 600,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../installer/payload/*",
      "../scripts/NoEcho-Control.ps1"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "longDescription": "NoEcho permite elegir los programas cuyo sonido no se comparte con la otra persona.",
    "shortDescription": "Audio privado para escritorio remoto",
    "category": "Utility",
    "copyright": "MIT"
  },
  "plugins": {}
}
